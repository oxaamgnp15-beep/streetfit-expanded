{
  "name": "streetfit",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "e2e": "turbo run e2e",
    "migrate": "pnpm --filter @streetfit/api prisma migrate deploy",
    "seed": "pnpm --filter @streetfit/api prisma db seed",
    "compose": "docker compose up --build",
    "sbom": "syft packages dir:. -o json > sbom.json",
    "scan": "trivy fs --exit-code 1 --severity HIGH,CRITICAL ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.1.0",
    "prisma": "5.22.0",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  }
}